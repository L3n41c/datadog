# .clang-format — Style C++ du projet.
#
# Style le plus consensuel possible : on part du style par défaut LLVM
# (BasedOnStyle: LLVM) et on ne liste ici QUE les options qui s'en écartent.
# Tout ce qui n'est pas listé hérite tel quel des valeurs par défaut de LLVM
# (vérifié avec clang-format 20, la version utilisée par la CI dans lint.yml).
# Référence : https://clang.llvm.org/docs/ClangFormatStyleOptions.html

---
Language: Cpp
Standard: Latest
BasedOnStyle: LLVM

# --- Indentation : tabulations pour l'indentation, espaces pour l'alignement ---
# UseTab: ForIndentation = tabulations uniquement pour l'indentation, tout le
# reste (alignement, continuations) en espaces — comme le style canonique de Go.
UseTab: ForIndentation
TabWidth: 4
IndentWidth: 4
AccessModifierOffset: -4

# --- Accolades : ouvrante sur sa propre ligne après les instructions de contrôle ---
# (style Allman pour les blocs de contrôle), attachée aux fonctions/classes,
# else/catch sur leur propre ligne.
BreakBeforeBraces: Custom
BraceWrapping:
  AfterControlStatement: Always
  BeforeCatch: true
  BeforeElse: true
  BeforeWhile: true

# --- Lignes courtes autorisées ---
AlwaysBreakTemplateDeclarations: Yes
AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: WithoutElse
AllowShortLambdasOnASingleLine: Inline

# --- Pointeurs et références à gauche : Type *ptr, Type &ref ---
PointerAlignment: Left

# --- Lignes : limite de 100 colonnes, 2 espaces avant un commentaire de fin de ligne ---
ColumnLimit: 100
SpacesBeforeTrailingComments: 2
KeepEmptyLinesAtTheStartOfBlocks: false

# --- Namespaces : seules les namespaces imbriquées sont indentées ; ligne vide
# entre les définitions ; initialiseurs de constructeur sur la ligne suivante ---
NamespaceIndentation: Inner
SeparateDefinitionBlocks: Always
PackConstructorInitializers: NextLine

# --- Inclusions : regroupées par blocs — en-têtes C système, puis C++, puis
# entre guillemets ; les fichiers de test sont traités comme le fichier principal ---
IncludeBlocks: Regroup
IncludeCategories:
  - {Regex: '^<ext/.*\.h>', Priority: 2}
  - {Regex: '^<.*\.h>', Priority: 1}
  - {Regex: '^<.*>', Priority: 1}
  - {Regex: '^".*"', Priority: 3}
IncludeIsMainRegex: '([-_](test|unittest))?$'
...
