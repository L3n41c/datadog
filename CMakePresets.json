{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 0,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "dev",
      "displayName": "Development (Debug + ASan + UBSan)",
      "description": "Debug build with AddressSanitizer and UndefinedBehaviorSanitizer",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined,pointer-compare,pointer-subtract -fno-omit-frame-pointer -g -O1",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
        "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "dev-tsan",
      "displayName": "Development (Debug + TSan)",
      "description": "Debug build with ThreadSanitizer for data race detection",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON",
        "CMAKE_CXX_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer -g -O1",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=thread",
        "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=thread"
      }
    },
    {
      "name": "dev-msan",
      "displayName": "Development (MSan)",
      "description": "Debug build with MemorySanitizer and smoke tests",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "clang++",
        "BUILD_TESTING": "ON",
        "DATADOG_BUILD_GTESTS": "OFF",
        "CMAKE_CXX_FLAGS": "-fsanitize=memory -fsanitize-memory-track-origins=2 -fno-omit-frame-pointer -fno-optimize-sibling-calls -g -O1",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=memory",
        "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=memory"
      }
    },
    {
      "name": "dev-cfi",
      "displayName": "Development (CFI)",
      "description": "Debug build with control-flow integrity checks",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON",
        "BUILD_TESTING": "ON",
        "CMAKE_CXX_FLAGS": "-flto=thin -fsanitize=cfi -fno-sanitize-trap=cfi -fvisibility=hidden -fno-omit-frame-pointer -g -O1",
        "CMAKE_EXE_LINKER_FLAGS": "-fuse-ld=lld -fsanitize=cfi -fno-sanitize-trap=cfi",
        "CMAKE_SHARED_LINKER_FLAGS": "-fuse-ld=lld -fsanitize=cfi -fno-sanitize-trap=cfi"
      }
    },
    {
      "name": "dev-safestack",
      "displayName": "Development (SafeStack)",
      "description": "Debug build with SafeStack protection",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "clang++",
        "BUILD_TESTING": "ON",
        "CMAKE_CXX_FLAGS": "-fsanitize=safe-stack -fno-omit-frame-pointer -g -O1",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=safe-stack",
        "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=safe-stack"
      }
    },
    {
      "name": "dev-scudo",
      "displayName": "Development (Scudo)",
      "description": "Debug build with the hardened Scudo allocator",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "clang++",
        "BUILD_TESTING": "ON",
        "CMAKE_CXX_FLAGS": "-fsanitize=scudo -fno-omit-frame-pointer -g -O1",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=scudo",
        "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=scudo"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "description": "Optimized release build with LTO",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "OFF",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON"
      }
    },
    {
      "name": "coverage",
      "displayName": "Coverage",
      "description": "Debug build with code coverage instrumentation (llvm-cov or gcov)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON",
        "ENABLE_COVERAGE": "ON"
      }
    },
    {
      "name": "fuzzer",
      "displayName": "Fuzzer (libFuzzer instrumentation)",
      "description": "Build with libFuzzer instrumentation. Use fuzzer-no-link for ordinary targets; link -fsanitize=fuzzer only into dedicated fuzz harness executables that define LLVMFuzzerTestOneInput.",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "clang++",
        "BUILD_TESTING": "ON",
        "ENABLE_FUZZER": "ON",
        "CMAKE_CXX_FLAGS": "-fsanitize=fuzzer-no-link,address,undefined -fno-omit-frame-pointer -g -O1",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
        "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "dev-tsan", "configurePreset": "dev-tsan" },
    { "name": "dev-msan", "configurePreset": "dev-msan" },
    { "name": "dev-cfi", "configurePreset": "dev-cfi" },
    { "name": "dev-safestack", "configurePreset": "dev-safestack" },
    { "name": "dev-scudo", "configurePreset": "dev-scudo" },
    { "name": "release", "configurePreset": "release" },
    { "name": "coverage", "configurePreset": "coverage" },
    { "name": "fuzzer", "configurePreset": "fuzzer" },
    { "name": "coverage-reset", "configurePreset": "coverage", "targets": ["coverage_reset"] },
    { "name": "coverage-report", "configurePreset": "coverage", "targets": ["coverage_report"] }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=1:strict_string_checks=1",
        "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1"
      },
      "output": { "outputOnFailure": true, "outputJUnitFile": "${sourceDir}/build/${presetName}/junit.xml" },
      "execution": { "noTestsAction": "error", "stopOnFailure": false }
    },
    {
      "name": "dev-tsan",
      "configurePreset": "dev-tsan",
      "environment": { "TSAN_OPTIONS": "halt_on_error=1" },
      "output": { "outputOnFailure": true, "outputJUnitFile": "${sourceDir}/build/${presetName}/junit.xml" },
      "execution": { "noTestsAction": "error", "stopOnFailure": false }
    },
    {
      "name": "dev-msan",
      "configurePreset": "dev-msan",
      "environment": { "MSAN_OPTIONS": "halt_on_error=1" },
      "output": { "outputOnFailure": true, "outputJUnitFile": "${sourceDir}/build/${presetName}/junit.xml" },
      "execution": { "noTestsAction": "error", "stopOnFailure": false }
    },
    {
      "name": "dev-cfi",
      "configurePreset": "dev-cfi",
      "output": { "outputOnFailure": true, "outputJUnitFile": "${sourceDir}/build/${presetName}/junit.xml" },
      "execution": { "noTestsAction": "error", "stopOnFailure": false }
    },
    {
      "name": "dev-safestack",
      "configurePreset": "dev-safestack",
      "output": { "outputOnFailure": true, "outputJUnitFile": "${sourceDir}/build/${presetName}/junit.xml" },
      "execution": { "noTestsAction": "error", "stopOnFailure": false }
    },
    {
      "name": "dev-scudo",
      "configurePreset": "dev-scudo",
      "output": { "outputOnFailure": true, "outputJUnitFile": "${sourceDir}/build/${presetName}/junit.xml" },
      "execution": { "noTestsAction": "error", "stopOnFailure": false }
    },
    {
      "name": "coverage",
      "configurePreset": "coverage",
      "environment": {
        "LLVM_PROFILE_FILE": "${sourceDir}/build/${presetName}/profraw/%p.profraw"
      },
      "output": { "outputOnFailure": true, "outputJUnitFile": "${sourceDir}/build/${presetName}/junit.xml" },
      "execution": { "noTestsAction": "error", "stopOnFailure": false }
    },
    {
      "name": "fuzzer",
      "configurePreset": "fuzzer",
      "output": { "outputOnFailure": true, "outputJUnitFile": "${sourceDir}/build/${presetName}/junit.xml" },
      "execution": { "noTestsAction": "error", "stopOnFailure": false }
    }
  ],
  "workflowPresets": [
    {
      "name": "dev",
      "steps": [
        { "type": "configure", "name": "dev" },
        { "type": "build", "name": "dev" },
        { "type": "test", "name": "dev" }
      ]
    },
    {
      "name": "dev-tsan",
      "steps": [
        { "type": "configure", "name": "dev-tsan" },
        { "type": "build", "name": "dev-tsan" },
        { "type": "test", "name": "dev-tsan" }
      ]
    },
    {
      "name": "dev-msan",
      "steps": [
        { "type": "configure", "name": "dev-msan" },
        { "type": "build", "name": "dev-msan" },
        { "type": "test", "name": "dev-msan" }
      ]
    },
    {
      "name": "dev-cfi",
      "steps": [
        { "type": "configure", "name": "dev-cfi" },
        { "type": "build", "name": "dev-cfi" },
        { "type": "test", "name": "dev-cfi" }
      ]
    },
    {
      "name": "dev-safestack",
      "steps": [
        { "type": "configure", "name": "dev-safestack" },
        { "type": "build", "name": "dev-safestack" },
        { "type": "test", "name": "dev-safestack" }
      ]
    },
    {
      "name": "dev-scudo",
      "steps": [
        { "type": "configure", "name": "dev-scudo" },
        { "type": "build", "name": "dev-scudo" },
        { "type": "test", "name": "dev-scudo" }
      ]
    },
    {
      "name": "release",
      "steps": [
        { "type": "configure", "name": "release" },
        { "type": "build", "name": "release" }
      ]
    },
    {
      "name": "coverage",
      "description": "Configure + build + reset stale coverage data + run tests (JUnit report) + generate the coverage report.",
      "steps": [
        { "type": "configure", "name": "coverage" },
        { "type": "build", "name": "coverage" },
        { "type": "build", "name": "coverage-reset" },
        { "type": "test", "name": "coverage" },
        { "type": "build", "name": "coverage-report" }
      ]
    },
    {
      "name": "fuzzer",
      "steps": [
        { "type": "configure", "name": "fuzzer" },
        { "type": "build", "name": "fuzzer" },
        { "type": "test", "name": "fuzzer" }
      ]
    }
  ]
}
