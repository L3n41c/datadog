root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
tab_width = 4

[*.{c,cc,cpp,cxx,c++,h,hh,hpp,hxx,C,H,h.in}]
indent_style = tab
indent_size = tab
max_line_length = 100

[{CMakeLists.txt,*.cmake}]
indent_size = 4
max_line_length = 100

[*.{md,markdown}]
trim_trailing_whitespace = false
max_line_length = off
