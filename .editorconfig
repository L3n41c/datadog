# .editorconfig — Universal editor configuration for this project
# https://editorconfig.org
#
# The default values below group what is common to most file types of the
# project: UTF-8, LF line endings, final newline, no trailing whitespace,
# 2-space indentation.
# Tabs are used as the indentation character only for C/C++ files and
# Makefiles.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
tab_width = 4

# --- C/C++: tabs (width 4) for indentation, spaces for alignment,
# 100-column limit.
# Mirrors .clang-format (UseTab: ForIndentation, IndentWidth/TabWidth: 4,
# ColumnLimit: 100), .dir-locals.el and .vimrc.
[*.{c,cc,cpp,cxx,c++,h,hh,hpp,hxx,C,H,h.in}]
indent_style = tab
indent_size = tab
tab_width = 4
max_line_length = 100

# --- Makefiles: tabs are required by make ---
[{Makefile,*.mk}]
indent_style = tab
indent_size = tab
tab_width = 4

# --- CMake: 4-space indentation, 100-column limit.
# Mirrors .cmake-format.yaml (format.tab_size: 4, format.line_width: 100,
# enforced by cmake-lint rule C0301).
[{CMakeLists.txt,*.cmake}]
indent_style = space
indent_size = 4
max_line_length = 100

# --- Markdown: trailing spaces are significant (hard line break);
# no line length limit ---
[*.{md,markdown}]
trim_trailing_whitespace = false
max_line_length = off

# --- License texts: free-width leading spaces ---
[{LICENSE,COPYING,NOTICE}]
indent_style = space
indent_size = 1
